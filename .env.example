# Example environment configuration for Syllabye backend

# Required: OpenAI API key used by LangChain ChatOpenAI and embeddings
OPENAI_API_KEY=your-openai-api-key

# Required: MongoDB connection
MONGODB_URI=mongodb://user:password@host:27017
MONGODB_DB_NAME=syllabye

# Required: secret key for signing JWT access tokens
# Use a long, high-entropy random string in production
SECRET_KEY=replace-with-strong-random-secret

# Optional: if you switch to Groq in app/llm_providers.py
# GROQ_API_KEY=your-groq-api-key
